# Extension build config. Injected into dist/ by `npm run build`
# (extensions can't read .env at runtime). Nothing here is secret:
# OAuth client IDs ship inside every extension. Never put a client SECRET here.

# 1) Chrome Extension OAuth client (Application type: Chrome Extension,
#    Item ID: najlilhbfkkocnnhfaofffpfehcipahe). Used by chrome.identity.getAuthToken.
#    Works in Google Chrome only. (Legacy name GOOGLE_CLIENT_ID is still read.)
GOOGLE_EXTENSION_CLIENT_ID=123456789012-abc.apps.googleusercontent.com

# 2) Web application OAuth client, with authorized redirect URI
#    https://najlilhbfkkocnnhfaofffpfehcipahe.chromiumapp.org/
#    Used by chrome.identity.launchWebAuthFlow. Works in Chrome, Brave, Arc, Edge.
#    Its SECRET goes in server/.env only.
GOOGLE_WEB_CLIENT_ID=123456789012-def.apps.googleusercontent.com

# Sync API (server/). Its origin becomes the manifest host permission.
API_BASE_URL=http://localhost:3000
