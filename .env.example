# Injected into dist/ at `bun run build` (extensions cannot read .env at runtime).

# MUST be a Chrome Extension OAuth client ID — Application type: Chrome Extension
# Item ID: najlilhbfkkocnnhfaofffpfehcipahe
# Chrome Extension clients have NO client secret. If you have a secret, you created a Web client
# and Google will show “Access blocked” for getAuthToken. See AUTH.md.
GOOGLE_CLIENT_ID=your-chrome-extension-client-id.apps.googleusercontent.com

API_BASE_URL=http://localhost:3000

# Do NOT set GOOGLE_CLIENT_SECRET here for getAuthToken.
# (Server may keep a secret only for unused legacy Web OAuth routes.)
