# Database
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Google — Chrome Extension OAuth client ID (NO secret needed for getAuthToken)
# Item ID in Google Cloud must be: najlilhbfkkocnnhfaofffpfehcipahe
GOOGLE_CLIENT_ID=your-chrome-extension-client-id.apps.googleusercontent.com

API_BASE_URL=http://localhost:3000
PORT=3000
