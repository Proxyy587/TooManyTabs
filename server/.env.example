# Database
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth — MUST be a "Web application" client (not Chrome Extension type)
# 1. Create OAuth client → Application type: Web application
# 2. Authorized redirect URIs: https://<YOUR_EXTENSION_ID>.chromiumapp.org/
# 3. Copy Client ID + Client secret here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional
PORT=3000
