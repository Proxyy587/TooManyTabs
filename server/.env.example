# Database (Neon / any Postgres)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT signing secret, at least 32 chars:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Chrome Extension OAuth client ID (same value as the root .env).
# Access tokens from chrome.identity.getAuthToken must be issued to this client.
GOOGLE_EXTENSION_CLIENT_ID=123456789012-abc.apps.googleusercontent.com

# Web application OAuth client (for chrome.identity.launchWebAuthFlow in Brave/Arc/Edge/Chrome).
# Redirect URI on that client: https://najlilhbfkkocnnhfaofffpfehcipahe.chromiumapp.org/
GOOGLE_WEB_CLIENT_ID=123456789012-def.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=GOCSPX-replace-me

# Optional: comma-separated extension IDs allowed to use the web flow.
ALLOWED_EXTENSION_IDS=najlilhbfkkocnnhfaofffpfehcipahe

API_BASE_URL=http://localhost:3000
PORT=3000
