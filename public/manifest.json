{
  "manifest_version": 3,
  "name": "TooManyTabs",
  "version": "0.4.0",
  "description": "Every tab you have open or saved, on one calm page. Find, save and close in seconds. Local-first.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity",
    "alarms",
    "favicon"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "oauth2": {
    "client_id": "INJECTED_FROM_ENV_AT_BUILD.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "action": {
    "default_title": "TooManyTabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open TooManyTabs"
    },
    "save-tab-to-later": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current tab to Later"
    }
  }
}
