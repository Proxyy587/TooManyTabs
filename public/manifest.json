{
  "manifest_version": 3,
  "name": "TooManyTabs",
  "version": "0.3.0",
  "description": "A cozy shelf for your tabs — save, group, and sync across devices",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "oauth2": {
    "client_id": "INJECTED_FROM_ENV_AT_BUILD.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "action": {
    "default_title": "TooManyTabs"
  }
}
