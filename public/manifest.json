{
  "manifest_version": 3,
  "name": "TooManyTabs",
  "version": "0.0.1",
  "description": "Save all open tabs into a list, just like OneTab",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "oauth2": {
    "client_id": "449556864758-82anektffjkus6dgd5qe37qnqhbmce2n.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
