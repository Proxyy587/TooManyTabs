{
  "manifest_version": 3,
  "name": "TooManyTabs",
  "version": "0.2.0",
  "description": "A cozy shelf for your tabs — save, group, and sync across devices",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "oauth2": {
    "client_id": "449556864758-gruk9uu3dh8c0g7ir2hmc652kk4gi5l1.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "action": {
    "default_title": "TooManyTabs"
  }
}
